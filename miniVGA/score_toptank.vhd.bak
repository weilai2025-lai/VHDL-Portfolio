library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity score_toptank is

	port(
		clk, move_pulse, rst_n:in std_logic;
		collision_state_bottom:in std_logic;
		score:out std_logic_vector(3 down to 0);
		freeze:out std_logic
		);
end score_toptank;

architecture rtl of score_toptank is
	constant win_score:unsigned(3 down to 0):=to_unsigned(3, score_reg'length);
	type state_t is (playing, ending);
	signal state_reg, state_next:state_t;
	signal score_reg, score_next:unsigned(3 down to 0);	
	
begin
	reg:process(clk, rst_n)
	begin
	if rst_n = '0' then
		freeze <= '0';
		score_reg <= (others => '0');
		state_reg <= playing;
	elsif rising_edge(clk) then
		score_reg <= score_next;
		state_reg <= state_next;
	end if;
	end process reg;
	
	comb:process(all)
	begin
	score_next <= score_reg;
	state_next <= state_reg
	if move_pulse = '1' then
		case(state_reg) is
		when playing =>
			if score_reg =  win_score then
				state_next <= ending;
			else
				state_next <= playing;
				if collision_state_bottom = '1' then
					score_next <= score_reg + to_unsigned(1, score_reg'length); 
				else
					score_next <= score_reg;
				end if;
			end if;
		when ending => 
			score_next <= score_reg;
			freeze <= '1';
		end case;
	end if;
	end process;
end architecture rtl;